# PostgreSQL Configuration
POSTGRES_USER=hnx_user
POSTGRES_PASSWORD=hnx_secure_pass
POSTGRES_DB=hnx_quantum_db
DATABASE_URL=postgresql://hnx_user:hnx_secure_pass@db:5432/hnx_quantum_db

# Redis Connection URL
REDIS_URL=redis://redis:6379/0

# JWT Security
SECRET_KEY=your_super_secret_jwt_key_here
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Zerodha Kite Connect Keys
KITE_API_KEY=your_api_key_here
KITE_API_SECRET=your_api_secret_here

# Telegram Alerts Settings
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here
